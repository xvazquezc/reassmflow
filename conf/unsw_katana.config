// UNSW Katana PBS Pro profile for reassmflow. No GPU resources are requested.
// Define the three shared Conda environment directories in config.yml.

conda.enabled = true
docker.enabled = false

process {
    executor = 'pbspro'
    queue = "${params.pbs_queue ?: ''}"
    clusterOptions = "${params.pbs_project ? "-P ${params.pbs_project}" : ''}"
    resourceLimits = [cpus: 24, memory: 256.GB, time: 48.h]
    errorStrategy = 'retry'
    maxRetries = 1

    withLabel: mapping {
        conda = params.conda_envs['mapping'] ?: "${projectDir}/envs/mapping.yaml"
    }
    withLabel: lr_assm {
        conda = params.conda_envs['lr_assm'] ?: "${projectDir}/envs/lr-env.yaml"
    }
    withLabel: sr_assm {
        conda = params.conda_envs['sr_assm'] ?: "${projectDir}/envs/sr-env.yaml"
    }
}

executor {
    queueSize = 50
    submitRateLimit = '10 sec'
}
