// UNSW Katana PBS Pro profile for reassmflow. No GPU resources are requested.
// Export the three shared Conda environment directories before launching.

conda.enabled = true
docker.enabled = false

process {
    executor = 'pbspro'
    resourceLimits = [cpus: 24, memory: 248.GB, time: 100.h]
    errorStrategy = 'retry'
    maxRetries = 1

    withLabel: mapping {
        conda = env('REASSMFLOW_MAPPING_ENV')
    }
    withLabel: lr_assm {
        conda = env('REASSMFLOW_LR_ASSM_ENV')
    }
    withLabel: sr_assm {
        conda = env('REASSMFLOW_SR_ASSM_ENV')
    }

    // Katana's nf-core profile sets a 24-CPU resource ceiling.
    // withName: FLYE_META_ASSEMBLY {
    //     cpus = 24
    // }
    // withName: MYLOASM_ASSEMBLY {
    //     cpus = 24
    // }
}

executor {
    queueSize = 50
    submitRateLimit = '10 sec'
}
