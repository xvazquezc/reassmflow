// UNSW Katana PBS Pro profile for reassmflow. No GPU resources are requested.
// Define the three shared Conda environment directories in config.yml.

conda.enabled = true
docker.enabled = false

def mappingCondaEnv = params.conda_envs.mapping
def lrAssmCondaEnv = params.conda_envs.lr_assm
def srAssmCondaEnv = params.conda_envs.sr_assm

process {
    executor = 'pbspro'
    resourceLimits = [cpus: 24, memory: 248.GB, time: 100.h]
    errorStrategy = 'retry'
    maxRetries = 1

    withLabel: mapping {
        conda = mappingCondaEnv
    }
    withLabel: lr_assm {
        conda = lrAssmCondaEnv
    }
    withLabel: sr_assm {
        conda = srAssmCondaEnv
    }

    // Katana's nf-core profile sets a 24-CPU resource ceiling.
    // withName: FLYE_META_ASSEMBLY {
    //     cpus = 24
    // }
    // withName: MYLOASM_ASSEMBLY {
    //     cpus = 24
    // }
}

executor {
    queueSize = 50
    submitRateLimit = '10 sec'
}
